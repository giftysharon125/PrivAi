# PrivAI Environment Configuration Template

# Server Port (Unique port 5500)
PORT=5500

# Environment Mode
NODE_ENV=development

# MongoDB Connection String (If unconfigured/unavailable, automatically falls back to In-Memory MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/privai

# JSON Web Token Secret Key
JWT_SECRET=privai_secure_jwt_token_secret_key_2026_dev

# Preferred AI Provider Options: 'gemini', 'openai', or 'demo'
AI_PROVIDER=gemini

# Google Gemini API Key (Optional - App falls back to Demo Mode if key is not provided)
GEMINI_API_KEY=

# OpenAI API Key (Optional)
OPENAI_API_KEY=

# Frontend Client URL for CORS (Unique port 5180)
CLIENT_URL=http://localhost:5180
